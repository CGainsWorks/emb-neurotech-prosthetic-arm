<?xml version="1.0"?>
<!--
  A1 six-axis prosthetic arm.

  Generated by scripts/generate_urdf.py from the model in
  kinematics/src/model.cpp. Do not edit: CI regenerates it and fails on
  any difference. Change the model instead.

  The visual geometry is primitive shapes, not meshes. No arm has been
  manufactured, and a mesh would be a claim about a physical object that
  does not exist.
-->
<robot name="a1_arm">

  <material name="shell"><color rgba="0.85 0.85 0.87 1.0"/></material>
  <material name="joint"><color rgba="0.25 0.28 0.32 1.0"/></material>
