<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arm_bringup</name>
  <version>1.0.0</version>
  <description>
    Launch files for the arm, a scripted gesture source for driving it without
    a classifier, a synthetic sEMG replay with a classifier interface stub for
    driving it from sEMG, a launch test of the whole graph and the end-to-end
    simulation that produces the numbers in docs/CONTROL_LOOP_TIMING.md.
  </description>
  <maintainer email="114424105+CGainsWorks@users.noreply.github.com">CGainsWorks</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>arm_msgs</depend>
  <depend>arm_control</depend>
  <depend>arm_interface</depend>
  <depend>arm_kinematics</depend>
  <depend>ament_index_cpp</depend>

  <build_depend>python3</build_depend>

  <exec_depend>arm_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>sensor_msgs</test_depend>
  <test_depend>trajectory_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
