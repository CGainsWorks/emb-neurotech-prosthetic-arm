# Normalise line endings so a Windows checkout and a Linux CI runner agree.
# The shell scripts are the reason this matters: a script committed with CRLF
# fails on Linux with "bad interpreter", which is a confusing way to find out.
* text=auto eol=lf
*.sh text eol=lf
*.bat text eol=crlf

# Binaries: never diffed, never line-ending mangled.
*.png binary
*.jpg binary
*.gif binary
*.mp4 binary
*.pdf binary
*.shapr binary
*.elf binary
*.bin binary
*.hex binary

# Git LFS. The two imported hardware archives are tracked this way and the
# remaining rules are here so that a mesh, a recording or a model added later
# goes to LFS rather than into the history.
*.zip filter=lfs diff=lfs merge=lfs -text
*.step filter=lfs diff=lfs merge=lfs -text
*.stl filter=lfs diff=lfs merge=lfs -text
*.bag filter=lfs diff=lfs merge=lfs -text
*.mcap filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.tflite filter=lfs diff=lfs merge=lfs -text

# Generated figures should not clutter a diff review.
hardware/**/analysis/*.svg -diff
