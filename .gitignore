# Build output. Everything here is regenerated by `make demo`.
build/
install/
log/
kinematics/build/
firmware/build/
firmware/build-arm/

# Generated results that are not evidence. The committed ones live in
# analysis/ and hardware/semg-servo-board/analysis/ and ARE tracked, because
# scripts/check_docs.py has to be able to verify the documentation against
# them on a fresh checkout.
analysis/sim/*_lossy.json
analysis/sim/*.csv
/tmp/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local overrides
*.local.yaml
.env
